root = true

# The repository stores LF (Git on Windows turns it into CRLF at checkout with core.autocrlf).
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.py]
indent_size = 4

# Vendored files stay byte for byte as published (.gitattributes, public/vendor/README.md).
[public/vendor/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
