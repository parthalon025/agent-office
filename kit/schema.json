{
 "version": "x1.6.1",
 "events": {
  "status": {
   "desc": "A bot changes state. The bot walks to rest or back to its seat when needed.",
   "fields": {
    "bot": "string",
    "status": "Status",
    "task": "string?",
    "quiet": "boolean?"
   }
  },
  "message": {
   "desc": "A bot says something to the user: chat line and speech bubble. text is Markdown (links, images, code, tables) unless format is \"plain\". attachments: [{type: image | file | link | video | audio, url, name?, size?, mime?, alt?, title?, description?, site?, thumb?, width?, height?}].",
   "fields": {
    "bot": "string",
    "text": "string",
    "say": "boolean?",
    "attachments": "object[]?",
    "format": "string?"
   }
  },
  "message.agent": {
   "desc": "One agent talks to another. Same room: the bots turn to each other; a long message (over 80 characters, or walk: true) makes the sender walk over. Other room or floor: an envelope rides the cable tray or the elevator.",
   "fields": {
    "from": "string",
    "to": "string",
    "text": "string",
    "walk": "boolean?",
    "attachments": "object[]?"
   }
  },
  "request": {
   "desc": "A bot needs a decision. Shows in Waiting on me, the chat and a toast. Optional risk (\"low\", \"medium\" or \"high\"), cost, preview and tool help the user decide.",
   "fields": {
    "bot": "string",
    "id": "string?",
    "text": "string",
    "actions": "string[]?",
    "quiet": "boolean?",
    "risk": "string?",
    "cost": "number?",
    "preview": "string?",
    "tool": "string?"
   }
  },
  "error": {
   "desc": "A bot stopped on an error.",
   "fields": {
    "bot": "string",
    "text": "string"
   }
  },
  "usage": {
   "desc": "Usage of the plan or limit, in percent. Spend is optional, in dollars: cost is the total for the goal or plan, costLimit is its limit, costs is the spend of each bot by name.",
   "fields": {
    "percent": "number?",
    "bots": "object?",
    "cost": "number?",
    "costLimit": "number?",
    "costs": "object?"
   }
  },
  "session.start": {
   "desc": "A session (one run or conversation) starts. With sessions: \"agent\" it shows as a count badge and a row in the Sessions tab; with sessions: \"session\" or isolated: true it gets its own grey blob from the elevator.",
   "fields": {
    "bot": "string",
    "session": "string",
    "title": "string?",
    "isolated": "boolean?"
   }
  },
  "session.end": {
   "desc": "A session ends. Its blob, if any, walks back to the elevator.",
   "fields": {
    "bot": "string",
    "session": "string",
    "result": "string?",
    "ok": "boolean?"
   }
  },
  "plan": {
   "desc": "An orchestrator makes a plan.",
   "fields": {
    "bot": "string",
    "goal": "string",
    "steps": "object[]"
   }
  },
  "plan.step": {
   "desc": "A plan step changes state.",
   "fields": {
    "bot": "string",
    "id": "string",
    "status": "Status",
    "owner": "string?"
   }
  },
  "delegate": {
   "desc": "A bot gives a task to another bot, or spawns a temporary subagent (spawn).",
   "fields": {
    "bot": "string",
    "to": "string?",
    "spawn": "object?",
    "roomId": "string?",
    "task": "string?"
   }
  },
  "subagent.done": {
   "desc": "A subagent returns its result. A temporary subagent leaves by the elevator.",
   "fields": {
    "bot": "string",
    "result": "string?",
    "remove": "boolean?"
   }
  },
  "tool.call": {
   "desc": "A bot calls a tool. A packet rides the cable tray.",
   "fields": {
    "bot": "string",
    "id": "string",
    "tool": "string",
    "kind": "string?",
    "args": "object?",
    "say": "boolean?"
   }
  },
  "tool.result": {
   "desc": "A tool call returns. The packet comes back in the result color.",
   "fields": {
    "bot": "string",
    "id": "string",
    "ok": "boolean?",
    "ms": "number?",
    "summary": "string?",
    "tokens": "number?",
    "cost": "number?"
   }
  },
  "knowledge": {
   "desc": "A bot reads a knowledge source.",
   "fields": {
    "bot": "string",
    "source": "string",
    "text": "string?"
   }
  },
  "skill.load": {
   "desc": "A bot loads a skill.",
   "fields": {
    "bot": "string",
    "skill": "string"
   }
  },
  "checkpoint": {
   "desc": "A bot saves a checkpoint.",
   "fields": {
    "bot": "string",
    "id": "string",
    "label": "string",
    "files": "number?"
   }
  },
  "rollback": {
   "desc": "A bot rolls back to a checkpoint.",
   "fields": {
    "bot": "string",
    "label": "string"
   }
  },
  "trigger.run": {
   "desc": "A scheduled job or trigger runs.",
   "fields": {
    "job": "string",
    "bot": "string?",
    "next": "string?"
   }
  },
  "model": {
   "desc": "A bot changes model, or falls back to another model.",
   "fields": {
    "bot": "string",
    "model": "string",
    "fallback": "string?"
   }
  },
  "floor.add": {
   "desc": "Add a floor.",
   "fields": {
    "floor": "object"
   }
  },
  "room.add": {
   "desc": "Add a room to a floor. A room of type security has no bots and six wall screens that a page repaints; room.screens gives their six titles.",
   "fields": {
    "floorId": "number",
    "room": "object"
   }
  },
  "floor.update": {
   "desc": "Rename a floor (name, key). Nothing else on it changes.",
   "fields": {
    "floorId": "number",
    "floor": "object"
   }
  },
  "room.update": {
   "desc": "Rename a room, give it a new id, or change its type. Its bots stay and follow the new id.",
   "fields": {
    "roomId": "string",
    "room": "object"
   }
  },
  "bot.add": {
   "desc": "Add a bot to a room.",
   "fields": {
    "roomId": "string",
    "bot": "BotDef"
   }
  },
  "bot.remove": {
   "desc": "Remove a bot.",
   "fields": {
    "bot": "string"
   }
  }
 },
 "commands": {
  "message": {
   "desc": "The user writes to one bot (bot) or broadcasts (target). attachments: images or files the user pasted, dropped or picked, as {type, url (data: or blob: or https), name, size, mime}.",
   "fields": {
    "bot": "string?",
    "target": "object?",
    "targetLabel": "string?",
    "text": "string",
    "attachments": "object[]?"
   }
  },
  "approve": {
   "desc": "The user approves a request.",
   "fields": {
    "bot": "string",
    "requestId": "string?"
   }
  },
  "decline": {
   "desc": "The user declines a request.",
   "fields": {
    "bot": "string",
    "requestId": "string?"
   }
  },
  "retry": {
   "desc": "Run the failed task again.",
   "fields": {
    "bot": "string"
   }
  },
  "dismiss": {
   "desc": "Clear an error.",
   "fields": {
    "bot": "string"
   }
  },
  "pause": {
   "desc": "Pause a bot.",
   "fields": {
    "bot": "string"
   }
  },
  "resume": {
   "desc": "Resume a bot.",
   "fields": {
    "bot": "string"
   }
  },
  "assign": {
   "desc": "Give a bot a task. The Manager sends it for each plan step (from = the Manager).",
   "fields": {
    "bot": "string",
    "task": "string",
    "from": "string?"
   }
  },
  "delegate": {
   "desc": "Ask a bot to delegate a task.",
   "fields": {
    "bot": "string",
    "to": "string",
    "task": "string"
   }
  },
  "rollback": {
   "desc": "Roll a bot back to a checkpoint.",
   "fields": {
    "bot": "string",
    "checkpoint": "object"
   }
  },
  "session.stop": {
   "desc": "Stop one session of a bot.",
   "fields": {
    "bot": "string",
    "session": "string"
   }
  },
  "cron.pause": {
   "desc": "Pause a scheduled job.",
   "fields": {
    "job": "string"
   }
  },
  "cron.resume": {
   "desc": "Resume a scheduled job.",
   "fields": {
    "job": "string"
   }
  }
 },
 "common": {
  "desc": "Fields every event can carry. seeded: true marks state the office already had (a scene mount sends the whole mirror again): the scene applies it, but records no history, plays no sound, sends no notification or toast, and adds no unread count or Activity line. at: the time of the event in ms; a seeded event with at after the last time the building was seen is news: it adds unread counts and Activity lines, and Since you left counts it.",
  "fields": {
   "seeded": "boolean?",
   "at": "number?"
  }
 },
 "enums": {
  "Shape": [
   "blob",
   "cone",
   "octa",
   "capsule"
  ],
  "Sessions": [
   "agent",
   "session"
  ]
 },
 "types": {
  "BotDef": {
   "desc": "A bot in bot.add. A field that is not listed here is reported as unknown. Fields that start with _ belong to the engine. usage, parent and session are set by the engine (usage: share of the weekly limit the bot used, in percent; parent: name of the bot that made this helper; session: id of the session it shows). A page may send them to restore a bot.",
   "fields": {
    "name": "string?",
    "role": "string?",
    "shape": "Shape?",
    "color": "string?",
    "status": "Status?",
    "task": "string?",
    "tasks": "string[]?",
    "sessions": "Sessions?",
    "orchestrator": "boolean?",
    "ephemeral": "boolean?",
    "platform": "string?",
    "identity": "string?",
    "owner": "string?",
    "model": "string?",
    "fallback": "string?",
    "tools": "string[]?",
    "knowledge": "string[]?",
    "skills": "string[]?",
    "channels": "string[]?",
    "triggers": "string[]?",
    "cost": "string?",
    "word": "string?",
    "usage": "number?",
    "parent": "string?",
    "session": "string?"
   }
  }
 },
