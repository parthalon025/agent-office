{
  "name": "agent-office",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "parthalon025 (Justin McFarland)",
  "repository": { "type": "git", "url": "https://github.com/parthalon025/agent-office.git" },
  "bugs": { "url": "https://github.com/parthalon025/agent-office/issues" },
  "homepage": "https://github.com/parthalon025/agent-office#readme",
  "type": "module",
  "description": "A floor-plan dashboard for Claude Code sessions, fed by hooks. Open and close sessions from the office.",
  "scripts": {
    "start": "node src/server.mjs",
    "start:branch": "node -e \"process.env.OFFICE_PORT='branch';process.env.OFFICE_OPEN='0';import('./src/server.mjs')\"",
    "probe": "node src/probe.mjs",
    "smoke": "node test/smoke.mjs",
    "gate:jobs": "node test/core-jobs.mjs",
    "paperclip:source": "node test/paperclip-source.mjs",
    "test:junction": "node test/junction.mjs",
    "check:merge": "node test/check-merge.mjs",
    "test": "node --import ./test/fixtures/temp-leaks.mjs --test \"test/*.test.mjs\""
  },
  "engines": { "node": ">=24.11" }
}
